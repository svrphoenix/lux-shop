# Docker Compose development configuration. Copy to .env.dev and replace placeholders.
DEBUG=True
SECRET_KEY=replace-with-a-random-development-secret
DATABASE_URL=postgresql://luxshop_user:replace-me@db:5432/luxshop
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000
POSTGRES_USER=luxshop_user
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=luxshop
NOVA_POSHTA_API_KEY=
NOVA_POSHTA_API_URL=https://api.novaposhta.ua/v2.0/json/
