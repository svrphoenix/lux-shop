# Copy this file to .env.production on the EC2 host and replace the placeholders.
# This file is used by docker-compose.production.yml.

# Django / backend
# Optional: set all three to create the initial Django admin on first startup.
# The startup command does not change the password of an existing superuser.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

DOMAIN=your-domain.pp.ua
DEBUG=False
SECRET_KEY=replace-with-long-random-secret
ALLOWED_HOSTS=your-domain.pp.ua,www.your-domain.pp.ua,backend,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://your-domain.pp.ua,https://www.your-domain.pp.ua
CSRF_TRUSTED_ORIGINS=https://your-domain.pp.ua,https://www.your-domain.pp.ua
SITE_NAME=Hop & Barley
FRONTEND_URL=https://your-domain.pp.ua
DATABASE_URL=postgres://luxshop_user:strong_password@your-rds-endpoint:5432/luxshop

# Email
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=orders@your-domain.pp.ua
SHOP_ADMIN_EMAIL=admin@your-domain.pp.ua

# Nova Poshta
NOVA_POSHTA_API_URL=https://api.novaposhta.ua/v2.0/json/
NOVA_POSHTA_API_KEY=your_nova_poshta_api_key

# S3 media storage. Prefer an EC2 instance role over long-lived access keys.
AWS_STORAGE_BUCKET_NAME=your-luxshop-media-bucket
AWS_S3_REGION_NAME=eu-central-1
# Optional CloudFront domain in front of this bucket, without https://.
AWS_S3_CUSTOM_DOMAIN=
# Private buckets use presigned media URLs. Set False only for intentionally
# public media objects or media delivered through a public CloudFront origin.
AWS_QUERYSTRING_AUTH=True
# Optional fallback only when the EC2 instance role is not used:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Frontend public API URL is embedded during the frontend image build.
NEXT_PUBLIC_API_URL=https://your-domain.pp.ua/api/v1
NEXT_PUBLIC_SITE_URL=https://your-domain.pp.ua
INTERNAL_API_URL=http://backend:8000/api/v1

# Start with the HTTP-only bootstrap config. After the certificate is issued,
# change this to ./nginx/default.conf.template and restart the nginx service.
NGINX_TEMPLATE=./nginx/bootstrap.conf.template
