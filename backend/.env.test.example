# ==============================================================================
# Local Test Environment Configuration (.env.test)
# Used by pytest / manage.py test against dedicated test database.
# ==============================================================================

# Disable debug mode to match production behavior during tests
DEBUG=False
SECRET_KEY=replace-with-a-random-test-only-secret

# --- Test Database Configuration ---
# Isolated PostgreSQL instance running on host-published port 5433
DATABASE_URL=postgresql://postgres:replace-me@127.0.0.1:5433/luxshop_test
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=luxshop_test

# --- Mock/Stub Service Endpoints ---
NOVA_POSHTA_API_KEY=
NOVA_POSHTA_API_URL=https://api.novaposhta.ua/v2.0/json/