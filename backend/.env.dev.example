# ==============================================================================
# Docker Compose Development Configuration (.env.dev)
# Copy to .env.dev for containerized local development.
# ==============================================================================

# --- Core Django Settings ---
DEBUG=True
SECRET_KEY=replace-with-a-random-development-secret
# Includes 'backend' service name for container-to-container communication
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# --- CORS & CSRF Settings ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend & Branding Settings ---
FRONTEND_URL=http://localhost:3000
SITE_NAME="Hop & Barley"

# --- PostgreSQL Container Configuration ---
# Connection string pointing to the 'db' container host in Docker network
DATABASE_URL=postgresql://luxshop_user:replace-me@db:5432/luxshop
# Credentials used by the official 'postgres' Docker image upon initialization
POSTGRES_USER=luxshop_user
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=luxshop

# --- Delivery Integration (Nova Poshta) ---
NOVA_POSHTA_API_KEY=
NOVA_POSHTA_API_URL=https://api.novaposhta.ua/v2.0/json/

# --- Email & Notifications (Resend SMTP) ---
# Leave RESEND_API_KEY empty to print emails to docker compose logs
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SHOP_ADMIN_EMAIL=