# ==============================================================================
# Direct Local Django Configuration (.env.local)
# Copy to .env.local and adjust for local environment without Docker.
# ==============================================================================

# --- Core Django Settings ---
# Enable debug mode for local development (MUST be False in production)
DEBUG=True
# Secret key used for cryptographic signing in local environment
SECRET_KEY=replace-with-a-random-local-secret
# Hosts/domain names that this Django site can serve
ALLOWED_HOSTS=localhost,127.0.0.1

# --- CORS & CSRF Settings ---
# Allowed origins for Cross-Origin Resource Sharing (Next.js frontend)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Trusted origins for unsafe requests (e.g. POST forms / API)
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend & Branding Settings ---
# Base URL of the Next.js frontend application (used in links / redirects)
FRONTEND_URL=http://localhost:3000
# Store brand name injected into transactional email templates and headers
SITE_NAME="Hop & Barley"

# --- Database Configuration ---
# PostgreSQL connection string for local host execution (outside Docker)
DATABASE_URL=postgresql://luxshop_user:replace-me@127.0.0.1:5432/luxshop

# --- Delivery Integration (Nova Poshta) ---
# Nova Poshta API v2.0 credentials and endpoint
NOVA_POSHTA_API_KEY=
NOVA_POSHTA_API_URL=https://api.novaposhta.ua/v2.0/json/

# --- Email & Notifications (Resend SMTP) ---
# Leave RESEND_API_KEY empty to fall back to Console Email Backend
RESEND_API_KEY=
# Verified sender email address in Resend dashboard
RESEND_FROM_EMAIL=
# Store manager email recipient for new order alerts
SHOP_ADMIN_EMAIL=